# ============================================================================
# pa-framework — Root Environment Configuration Template (.env / secrets.env)
# ============================================================================
# Copy this file to ~/.pa/secrets.env (or .env) and fill in your secrets.
# Format: KEY=VALUE (quotes are optional and stripped automatically).

# ----------------------------------------------------------------------------
# 1. Core Telegram Bot (Required)
# ----------------------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Destination Telegram chat ID (DM user ID or supergroup ID starting with -100)
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------------------------
# 2. LLM Provider API Keys (Configure at least one)
# ----------------------------------------------------------------------------

# Anthropic Claude API key (for claude / zclaude worker)
ANTHROPIC_API_KEY=

# OpenAI API key (for codex worker)
OPENAI_API_KEY=

# Groq API key (Recommended for ultra-fast voice transcription)
GROQ_API_KEY=

# ----------------------------------------------------------------------------
# 3. Bot Customization & Paths (Optional)
# ----------------------------------------------------------------------------
# User display name used in bot system prompts (Default: "the user")
# PA_USER_NAME=Alex

# Framework state directory (Default: ~/.pa)
# PA_HOME=~/.pa

# Timezone offset in minutes from UTC (Default: 330 for IST UTC+5:30; -300 for EST)
# PA_TZ_OFFSET_MINUTES=330

# ----------------------------------------------------------------------------
# 4. Error & Notification Routing (Optional)
# ----------------------------------------------------------------------------
# Dedicated chat and thread ID for system error alerts (falls back to TELEGRAM_CHAT_ID)
# PA_ALERTS_CHAT_ID=-1001234567890
# PA_ALERTS_THREAD_ID=0

# Self-improver code-fix loop: wall-clock budget per run (Default: 2400000 = 40 min)
# PA_SELF_IMPROVER_CODE_FIX_BUDGET_MS=2400000

# Self-improver code-fix loop: optional hard cap on fix attempts per run (Default: unset = unlimited)
# PA_SELF_IMPROVER_MAX_CODE_FIXES=

# Wall-clock budget for one whole `pa catchup` run (maintenance + skill dispatch).
# Past it, catchup stops dispatching, releases its lock, and exits rather than
# waiting on a wedged skill (2026-09-10 incident fix). Default: 900000 = 15 min.
# PA_CATCHUP_BUDGET_MS=900000

# Wall-clock guard on an agy/agyc worker producing no usable output; kills the
# run so a silent spin can't hold the only worker slot indefinitely, even while
# the stream keeps emitting bytes (2026-09-10 incident fix, worker-exec.ts).
# Resets on any usable output. Default: 300000 = 5 min.
# PA_AGY_NO_PROGRESS_TIMEOUT_MS=300000

# Alert-census maintenance job: only pages pa-alerts when 7-day sent/day is at or above this (Default: 50)
# PA_ALERT_CENSUS_NOTIFY_PER_DAY=50

# Where Google reauth links (e.g. /reauth) are delivered (Default: TELEGRAM_CHAT_ID's first entry, thread 0)
# PA_REAUTH_CHAT_ID=-1001234567890
# PA_REAUTH_THREAD_ID=0

# Directory that `npm test` points TMP/TEMP at, so test temp files land off a slow
# spindle. Used only if it exists; the runners fall back to C:/wt/tmp, then to the OS
# default. Leave unset on CI.
# PA_TEST_TMP_DIR=C:/wt/tmp

# Disable the bot's self-restart maintenance job (idle-gated, sentinel-based restart
# when dist/.build-stamp is newer than the running process). Default: enabled.
# PA_BOT_SELF_RESTART=0

# Telegram user id gating operator-only inline-button callbacks (approve/reject/run-now/
# replay/etc). Unset: those buttons answer with a "set it" alert instead of acting.
# Equals the positive (DM) entry in TELEGRAM_CHAT_ID.
# PA_OPERATOR_USER_ID=123456789

# Route bot replies over 3,500 chars or containing a markdown table through the Bot API's
# sendRichMessage, falling back to the normal chunked send on any error. Default: unset = off.
# PA_RICH_MESSAGES=1

# ----------------------------------------------------------------------------
# 5. Voice Transcription Engine (Optional)
# ----------------------------------------------------------------------------
# Options: groq (recommended cloud), openai, deepgram, or local (Whisper CPU)
# PA_VOICE_ENGINE=groq

# ----------------------------------------------------------------------------
# 6. Daily Mail Brief LLM (Optional — only if you use the daily-mail-brief sample)
# ----------------------------------------------------------------------------
# Path to the agy (Antigravity CLI) shim/binary used for the briefing's LLM call
# (no default — set when using a shim)
# AGY_CMD=/path/to/agy

# Model/timeout passed to agy (Defaults: gemini-3.8-flash-high / 10m)
# DAILY_MAIL_BRIEF_MODEL=gemini-3.8-flash-high
# DAILY_MAIL_BRIEF_PRINT_TIMEOUT=10m

# ----------------------------------------------------------------------------
# 7. Build/test serialization (Optional)
# ----------------------------------------------------------------------------
# `npm run build` and `npm test` take the `@build` reservation automatically so two
# concurrent builds cannot tear each other's dist/. Set to 0 to skip it for a scoped
# test run (e.g. parallel builders in one wave). Never set it for a pre-push gate.
# PA_BUILD_LOCK=0

# ----------------------------------------------------------------------------
# 8. Worker-edit audit (AI-175) (Optional)
# ----------------------------------------------------------------------------
# Bot worker dispatches are audited for tracked-file edits made with no covering
# reservation (before/after snapshot + reconciliation; one content-hash-keyed
# alert per dispatch). See docs/CONFIGURATION.md for full semantics.
# PA_WORKER_EDIT_AUDIT=0                       # disable the whole mechanism
# PA_WORKER_EDIT_AUDIT_IGNORE=                 # comma-separated path prefixes never reported
# PA_WORKER_EDIT_AUDIT_MAX_ALERTS_PER_DAY=10   # delivered-alert cap per UTC day
# PA_WORKER_EDIT_WINDOW_MAX_MS=7200000         # sweeper closes an alive-PID window past this age

# ----------------------------------------------------------------------------
# 9. Voice-inbox transcription drain + deterministic fallback (Optional)
# ----------------------------------------------------------------------------
# The telegram bot's poll-tick drain transcribes new voice-inbox recordings; the
# pa-host fallback job transcribes/routes/re-routes a stuck task by script, with
# no LLM, when nothing did it in time. See docs/voice-inbox-config.md.
# PA_VOICE_INBOX_TRANSCRIBE_DRAIN=0                      # disable the bot drain and its route hold
# PA_VOICE_INBOX_TRANSCRIBE_DRAIN_TIMEOUT_MS=300000      # 5 min; process tree killed past it
# PA_VOICE_INBOX_FALLBACK=0                              # disable the job entirely
# PA_VOICE_INBOX_FALLBACK_TRANSCRIBING_STALE_MS=120000   # 2 min
# PA_VOICE_INBOX_FALLBACK_RECEIVED_STALE_MS=360000       # 6 min
# PA_VOICE_INBOX_FALLBACK_ROUTED_STALE_MS=1200000        # 20 min
# PA_VOICE_INBOX_FALLBACK_MIN_AUDIO_BYTES=8192           # 8 KB
# PA_VOICE_INBOX_FALLBACK_DEFAULT_TOPIC=                 # override <inboxChatId>_0

# ----------------------------------------------------------------------------
# 10. Voice-inbox app config overrides (AI-223) (Optional)
# ----------------------------------------------------------------------------
# The voice-inbox API process's own env overrides (win over its config.yaml
# voice_inbox: block) — separate from section 9's pa-host fallback-job knobs
# above. See docs/voice-inbox-config.md.
# VOICE_INBOX_PORT=8787
# VOICE_INBOX_INBOX_TOPIC=CHATID_THREADID
# VOICE_INBOX_MIN_AUDIO_BYTES=8192       # 8 KB; uploads under this are rejected (400) at POST /tasks

# ----------------------------------------------------------------------------
# 11. Auth broker (AI-220) (Optional)
# ----------------------------------------------------------------------------
# Generalized phone-approval CLI (`pa auth request|wait|answer|learn`) for any
# provider that needs a URL opened, a code entered, a key supplied, or a
# yes/no answered. See docs/auth-broker.md.
# PA_AUTH_TENANT=                                  # single-tenant deployments never need this
# PA_VOICE_INBOX_FALLBACK_RUNNING_STALE_MS=1200000  # AI-221 dead-dispatch re-dispatch threshold
# The callback endpoint's base URL has no env var of its own — point
# GOOGLE_AUTH_REDIRECT_URI (above) at <relay base url>/api/v1/auth/callback instead.

# ----------------------------------------------------------------------------
# 12. Launch cadence and machine watchdogs (Optional)
# ----------------------------------------------------------------------------
# `pa catchup --loop`'s lane cadence and lifetime cap, plus nonpaged-pool-watch's
# alert thresholds. See docs/CONFIGURATION.md "Resource tuning env vars" and
# "Blackboard lock env vars".
# PA_CATCHUP_LOOP_INTERVAL_MS=60000                    # 1 min; cadence of both catchup-loop lanes
# PA_CATCHUP_LOOP_MAX_MS=21600000                      # 6 h; loop lifetime cap before a clean exit
# PA_CATCHUP_LOOP_HEARTBEAT_STALE_MS=300000            # 5 min; heartbeat + lane-progress staleness baked into the launcher at sync
# PA_STORE_WAIT_MAX_MS=180000                          # 3 min; wait behind a stuck in-process store queue before detaching
# PA_CATCHUP_KILL_EXIT_WAIT_S=120                      # 2 min; launcher wait for a killed loop to exit (read from the launcher's own environment, not this file)
# PA_POOL_NONPAGED_ALERT_BYTES=3221225472              # 3 GiB; nonpaged-pool-watch absolute floor
# PA_POOL_NONPAGED_GROWTH_BYTES_PER_HOUR=104857600     # 100 MiB/h; nonpaged-pool-watch growth trigger
# PA_POOL_NONPAGED_MIN_WINDOW_MS=600000                # 10 min; minimum baseline age before growth is evaluated
# PA_POOL_TAGS_TOP_N=3                                 # top pool tags named in a nonpaged-pool-watch alert

# ----------------------------------------------------------------------------
# 13. Dynamic worker slots (Optional)
# ----------------------------------------------------------------------------
# Machine-wide worker-slot cap. PA_MAX_CONCURRENT_WORKERS is the ceiling; unset it
# to derive clamp(4, cores*4, 64). The pool runs AT the ceiling until the machine
# is visibly struggling, then sheds a quarter per pressured minute down to
# PA_SLOTS_MIN, and climbs back after two clean minutes. See
# docs/CONFIGURATION.md "Resource tuning env vars".
# PA_MAX_CONCURRENT_WORKERS=3
# PA_DYNAMIC_SLOTS=0
# PA_SLOTS_MIN=3
# PA_SLOTS_PHYSICAL_BRAKE_MB=400                   # pressure input: free physical floor; 0 = off
# PA_SLOTS_CPU_BRAKE_PCT=90                        # pressure input: CPU busy percent; 0 = off
# PA_SLOTS_DISK_QUEUE_BRAKE=8                      # pressure input: disk queue length; 0 = off

# ----------------------------------------------------------------------------
# 14. TypeSafe typed judgments (Optional)
# ----------------------------------------------------------------------------
# TypeSafe API key. Unset = every typed path stays off. Setting it changes
# nothing by itself: routing_policy.judge: typesafe and voice_inbox_routing
# in config.yaml turn paths on. Check it with `pa typesafe check`.
# See docs/CONFIGURATION.md "TypeSafe typed routing".
# TYPESAFE_API_KEY=
# TYPESAFE_TIMEOUT_MS=4000                          # whole-call budget incl. one retry
# PA_VOICE_INBOX_TYPED_ROUTING=0                    # kill switch for the bot's typed routing

# ----------------------------------------------------------------------------
# 15. Capability provision + delivery floor (Optional)
# ----------------------------------------------------------------------------
# `pa init --provision` walks a setup ladder: it discovers assistant CLIs and
# API keys (by presence only), asks before connecting anything, and can set up
# a free-tier worker. Telegram is optional — notifications always land as
# local files under ~/.pa/outbox/ even with no bot configured.
# PA_OUTBOX_DIR=                      # override the degraded-delivery folder (default ~/.pa/outbox)
# OPENROUTER_API_KEY=                 # free-tier-friendly key; opencode reads it from the environment
# PA never writes a key value into config.yaml — workers read keys from the
# environment. See docs/CONFIGURATION.md "Capability provision (`pa init --provision`)".
