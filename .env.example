# ============================================================================
# pa-framework — Root Environment Configuration Template (.env / secrets.env)
# ============================================================================
# Copy this file to ~/.pa/secrets.env (or .env) and fill in your secrets.
# Format: KEY=VALUE (quotes are optional and stripped automatically).

# ----------------------------------------------------------------------------
# 1. Core Telegram Bot (Required)
# ----------------------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Destination Telegram chat ID (DM user ID or supergroup ID starting with -100)
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------------------------
# 2. LLM Provider API Keys (Configure at least one)
# ----------------------------------------------------------------------------

# Anthropic Claude API key (for claude / zclaude worker)
ANTHROPIC_API_KEY=

# OpenAI API key (for codex worker)
OPENAI_API_KEY=

# Groq API key (Recommended for ultra-fast voice transcription)
GROQ_API_KEY=

# ----------------------------------------------------------------------------
# 3. Bot Customization & Paths (Optional)
# ----------------------------------------------------------------------------
# User display name used in bot system prompts (Default: "the user")
# PA_USER_NAME=Alex

# Framework state directory (Default: ~/.pa)
# PA_HOME=~/.pa

# Timezone offset in minutes from UTC (Default: 330 for IST UTC+5:30; -300 for EST)
# PA_TZ_OFFSET_MINUTES=330

# ----------------------------------------------------------------------------
# 4. Error & Notification Routing (Optional)
# ----------------------------------------------------------------------------
# Dedicated chat and thread ID for system error alerts (falls back to TELEGRAM_CHAT_ID)
# PA_ALERTS_CHAT_ID=-1001234567890
# PA_ALERTS_THREAD_ID=0

# Self-improver code-fix loop: wall-clock budget per run (Default: 2400000 = 40 min)
# PA_SELF_IMPROVER_CODE_FIX_BUDGET_MS=2400000

# Self-improver code-fix loop: optional hard cap on fix attempts per run (Default: unset = unlimited)
# PA_SELF_IMPROVER_MAX_CODE_FIXES=

# Alert-census maintenance job: only pages pa-alerts when 7-day sent/day is at or above this (Default: 50)
# PA_ALERT_CENSUS_NOTIFY_PER_DAY=50

# Where Google reauth links (e.g. /reauth) are delivered (Default: TELEGRAM_CHAT_ID's first entry, thread 0)
# PA_REAUTH_CHAT_ID=-1001234567890
# PA_REAUTH_THREAD_ID=0

# Directory that `npm test` points TMP/TEMP at, so test temp files land off a slow
# spindle. Used only if it exists; the runners fall back to C:/wt/tmp, then to the OS
# default. Leave unset on CI.
# PA_TEST_TMP_DIR=C:/wt/tmp

# Disable the bot's self-restart maintenance job (idle-gated, sentinel-based restart
# when dist/.build-stamp is newer than the running process). Default: enabled.
# PA_BOT_SELF_RESTART=0

# Telegram user id gating operator-only inline-button callbacks (approve/reject/run-now/
# replay/etc). Unset: those buttons answer with a "set it" alert instead of acting.
# Equals the positive (DM) entry in TELEGRAM_CHAT_ID.
# PA_OPERATOR_USER_ID=123456789

# Route bot replies over 3,500 chars or containing a markdown table through the Bot API's
# sendRichMessage, falling back to the normal chunked send on any error. Default: unset = off.
# PA_RICH_MESSAGES=1

# ----------------------------------------------------------------------------
# 5. Voice Transcription Engine (Optional)
# ----------------------------------------------------------------------------
# Options: groq (recommended cloud), openai, deepgram, or local (Whisper CPU)
# PA_VOICE_ENGINE=groq

# ----------------------------------------------------------------------------
# 6. Daily Mail Brief LLM (Optional — only if you use the daily-mail-brief sample)
# ----------------------------------------------------------------------------
# Path to the agy (Antigravity CLI) shim/binary used for the briefing's LLM call
# (no default — set when using a shim)
# AGY_CMD=/path/to/agy

# Model/timeout passed to agy (Defaults: gemini-3.7-flash-high / 10m)
# DAILY_MAIL_BRIEF_MODEL=gemini-3.7-flash-high
# DAILY_MAIL_BRIEF_PRINT_TIMEOUT=10m

# ----------------------------------------------------------------------------
# 7. Build/test serialization (Optional)
# ----------------------------------------------------------------------------
# `npm run build` and `npm test` take the `@build` reservation automatically so two
# concurrent builds cannot tear each other's dist/. Set to 0 to skip it for a scoped
# test run (e.g. parallel builders in one wave). Never set it for a pre-push gate.
# PA_BUILD_LOCK=0
